{
  "name": "handoff-control-tower",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:inbox-ingestion": "vitest run tests/integration/inbox-ingestion.test.ts",
    "test:outbox-dispatcher": "vitest run tests/integration/outbox-transaction.test.ts tests/integration/outbox-dispatcher.test.ts",
    "test:mock-adapters": "vitest run tests/unit/mock-adapters.contract.test.ts",
    "test:fulfillment-process": "vitest run tests/unit/fulfillment-process.test.ts tests/integration/fulfillment-process-manager.test.ts",
    "test:exception-commands": "vitest run tests/unit/exception-commands.test.ts tests/integration/exception-commands.test.ts",
    "test:reconciliation": "vitest run tests/unit/reconciliation.test.ts tests/integration/reconciliation-repository.test.ts tests/integration/reconciliation.test.ts",
    "test:operator": "vitest run tests/unit/console.test.ts tests/integration/operator-repository.test.ts tests/integration/operator-api.test.ts",
    "test:simulator": "vitest run tests/unit/simulator-control.test.ts",
    "test:tenant-isolation": "vitest run tests/integration/tenant-isolation.test.ts",
    "test:migration-from-zero": "vitest run tests/integration/migration-from-zero.test.ts",
    "test:reset-guard": "vitest run tests/unit/reset-guard.test.ts",
    "test:health": "vitest run tests/unit/health.test.ts",
    "test:security": "vitest run tests/unit/security.test.ts tests/unit/observability.test.ts tests/unit/safe-error.test.ts tests/integration/observability-trace.test.ts",
    "test:scenarios": "vitest run tests/unit/scenario-campaign.test.ts",
    "test:properties": "vitest run tests/unit/property-sequences.test.ts",
    "test:scenarios:twice": "tsx scripts/run-scenarios.ts",
    "release:evidence": "tsx scripts/run-scenarios.ts",
    "release:rehearse": "bash scripts/rehearse-release.sh",
    "security:scan": "tsx scripts/security-scan.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:reset": "tsx scripts/reset-demo.ts",
    "start:api": "tsx apps/api/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^16.5.0",
    "ioredis": "^5.6.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.4",
    "fast-check": "^4.2.0"
  }
}
