{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@handoff/config": ["packages/config/src/index.ts"],
      "@handoff/db": ["packages/db/src/index.ts"],
      "@handoff/domain": ["packages/domain/src/index.ts"],
      "@handoff/adapters": ["packages/adapters/src/index.ts"],
      "@handoff/queue": ["packages/queue/src/index.ts"]
    },
    "outDir": "dist"
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
