APP_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/handoff_control_tower_demo
REDIS_URL=redis://127.0.0.1:6379
ADAPTER_MODE=mock
MOCK_COMMERCE_WEBHOOK_SECRET=local-commerce-secret
MOCK_WMS_WEBHOOK_SECRET=local-wms-secret
MOCK_CARRIER_WEBHOOK_SECRET=local-carrier-secret
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
OUTBOX_RETRY_JITTER_MS=250
PARKED_EVENT_MAX_AGE_MINUTES=30
RECONCILIATION_INTERVAL_MINUTES=15
ALLOW_PARTIAL_INVOICE_ELIGIBILITY=false
ENABLE_DEMO_SIMULATOR=true
INGEST_MAX_BODY_BYTES=1048576
CREDENTIAL_ENCRYPTION_SECRET=local-credential-encryption-secret
INGEST_RATE_LIMIT_PER_MINUTE=60
COMMAND_RATE_LIMIT_PER_MINUTE=30
RETRY_RATE_LIMIT_PER_MINUTE=10
RECONCILIATION_RATE_LIMIT_PER_MINUTE=5
